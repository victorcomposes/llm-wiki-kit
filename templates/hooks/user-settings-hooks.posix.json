{
  "//": "MERGE these three entries into ~/.claude/settings.json — never overwrite the user's file. User scope is mandatory: settings.json does not cascade, and these must fire in every session under {{ROOT_DIR}}. Substitute {{VAULT_DIR}} with a forward-slash path. Requires jq on PATH.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{VAULT_DIR}}/.claude/hooks/capture-nudge.sh\"",
            "statusMessage": "Checking service-knowledge capture..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{VAULT_DIR}}/.claude/hooks/stop-nudge.sh\"",
            "statusMessage": "Vault bookkeeping check..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{VAULT_DIR}}/.claude/hooks/guard-git.sh\"",
            "statusMessage": "git guard: staging + commit convention..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"{{VAULT_DIR}}/.claude/hooks/secret-scan.sh\"",
            "timeout": 15,
            "statusMessage": "Scanning staged vault changes for secrets"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{VAULT_DIR}}/.claude/hooks/council-gate.sh\"",
            "statusMessage": "Council gate: migration/contract path check..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{VAULT_DIR}}/.claude/hooks/council-prompt.sh\"",
            "statusMessage": "Council trigger: design-idea check..."
          }
        ]
      }
    ]
  }
}
