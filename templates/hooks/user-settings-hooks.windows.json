{
  "//": "MERGE these three entries into ~/.claude/settings.json — never overwrite the user's file. User scope is mandatory: settings.json does not cascade, and these must fire in every session under {{ROOT_DIR}}. Substitute {{VAULT_DIR}} with a native backslash path.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "& '{{VAULT_DIR}}\\.claude\\hooks\\capture-nudge.ps1'",
            "shell": "powershell",
            "statusMessage": "Checking service-knowledge capture..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& '{{VAULT_DIR}}\\.claude\\hooks\\stop-nudge.ps1'",
            "shell": "powershell",
            "statusMessage": "Vault bookkeeping check..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "& '{{VAULT_DIR}}\\.claude\\hooks\\guard-git.ps1'",
            "statusMessage": "git guard: staging + commit convention...",
            "shell": "powershell"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "& '{{VAULT_DIR}}\\.claude\\hooks\\council-gate.ps1'",
            "statusMessage": "Council gate: migration/contract path check...",
            "shell": "powershell"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& '{{VAULT_DIR}}\\.claude\\hooks\\council-prompt.ps1'",
            "statusMessage": "Council trigger: design-idea check...",
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}
